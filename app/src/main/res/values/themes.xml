<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.DashMart" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/black</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Secondary highlight color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/secondary2</item>

        <!-- Background colors -->
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/nav_bar</item>

        <!-- Light icons for dark background, dark icons for light -->
        <item name="android:windowLightStatusBar">true</item>
        <!-- Optional custom font -->
    </style>
    <style name="buttonMaterial" parent="Widget.MaterialComponents.Button">

        <item name="textAllCaps">true</item>
        <item name="android:height">60dp</item>
        <item name="rippleColor">@color/black</item>
        <item name="cornerRadius">100dp</item>
        <item name="backgroundTint">@color/black</item>
        <item name="android:textColor">@color/white</item>

    </style>
    <style name="buttonMaterialLessRounded" parent="Widget.MaterialComponents.Button">

        <item name="textAllCaps">true</item>
        <item name="android:height">60dp</item>
        <item name="height">50dp</item>
        <item name="cornerRadius">5dp</item>
        <item name="backgroundTint">@color/black</item>
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="editTextMaterialBackground" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">true</item>
        <item name="hintAnimationEnabled">true</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="boxStrokeColor">@color/black</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="boxCornerRadiusTopEnd">100dp</item>
        <item name="boxCornerRadiusTopStart">100dp</item>
        <item name="boxCornerRadiusBottomEnd">100dp</item>
        <item name="boxCornerRadiusBottomStart">100dp</item>
        <!--        <item name="hintTextColor">@color/colorPrimary</item>-->
        <item name="android:textColorHint">@color/grey</item>
        <item name="android:drawableTint">@color/black</item>
        <item name="height">40dp</item>
        <item name="android:height">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:editTextColor">@color/black</item>

    </style>
    <style name="editTextMaterialBackgroundLessRounded" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">true</item>
        <item name="hintAnimationEnabled">true</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="boxStrokeColor">@color/yellow</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="boxCornerRadiusTopEnd">5dp</item>
        <item name="boxCornerRadiusTopStart">5dp</item>
        <item name="boxCornerRadiusBottomEnd">5dp</item>
        <item name="boxCornerRadiusBottomStart">5dp</item>
        <item name="android:textColorHint">@color/grey</item>
        <item name="android:drawableTint">@color/black</item>
        <item name="height">35dp</item>
        <item name="android:height">35dp</item>
        <item name="android:layout_height">35dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:editTextColor">@color/black</item>

    </style>
</resources>